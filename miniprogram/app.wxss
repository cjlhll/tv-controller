/* 深色规范：降低饱和、用描边分层，主按钮只出现一次 */
page {
  background: #0f172a;
  color: #e8eef7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100%;
}

.wrap {
  padding: 28rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.kicker {
  color: #94a3b8;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.55;
}

.card {
  background: #1e293b;
  border: 2rpx solid #334155;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.card-tap:active {
  background: #243044;
}

.card-unlocked {
  border-color: #14532d;
}

.card-pending {
  border-color: #78350f;
}

.device-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.device-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.device-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #f8fafc;
}

.device-meta {
  color: #94a3b8;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.hw-specs {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #334155;
}

.hw-spec {
  width: 50%;
  box-sizing: border-box;
  padding: 10rpx 16rpx 10rpx 0;
}

.hw-spec-wide {
  width: 100%;
}

.hw-spec-k {
  display: block;
  color: #94a3b8;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.hw-spec-v {
  color: #e2e8f0;
  font-size: 28rpx;
  font-weight: 500;
  word-break: break-all;
}

.pill {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #334155;
  color: #cbd5e1;
}

.pill-unlocked {
  background: #14532d;
  color: #86efac;
}

.pill-pending {
  background: #78350f;
  color: #fbbf24;
}

.pill-locked,
.pill-unbound,
.pill-unknown {
  background: #334155;
  color: #94a3b8;
}

.card-foot {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hint,
.unit,
.section-label,
.log-time,
.empty-desc {
  color: #94a3b8;
}

.hint,
.link {
  font-size: 24rpx;
}

.link {
  color: #cbd5e1;
  padding: 8rpx 0 8rpx 16rpx;
}

.section-label {
  font-size: 24rpx;
  margin: 8rpx 0 16rpx;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 20rpx;
  font-weight: 600;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn:active {
  opacity: 0.86;
}

.btn-primary {
  background: #d97706;
  color: #fff7ed;
}

.btn-secondary {
  background: #334155;
  color: #e2e8f0;
}

.btn-danger {
  background: #3f1d1d;
  color: #fca5a5;
  border: 2rpx solid #7f1d1d;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row .btn {
  flex: 1;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.opt {
  width: calc(50% - 8rpx);
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  box-sizing: border-box;
  background: #1e293b;
  border: 2rpx solid #334155;
  border-radius: 20rpx;
  color: #e2e8f0;
  font-size: 28rpx;
  font-weight: 500;
}

.opt:active {
  background: #243044;
}

.opt-on {
  background: #422006;
  border-color: #d97706;
  color: #fbbf24;
  font-weight: 600;
}

.empty {
  padding: 64rpx 24rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f8fafc;
}

.empty-desc {
  font-size: 26rpx;
  margin: 12rpx auto 0;
  line-height: 1.55;
  max-width: 480rpx;
}

.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #0f172a;
  border: 2rpx solid #334155;
  border-radius: 20rpx;
  box-sizing: border-box;
}

.field .input {
  flex: 1;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  background: transparent;
  color: #f8fafc;
  font-size: 32rpx;
}

.input-code {
  text-align: center;
  font-size: 44rpx;
  letter-spacing: 16rpx;
  font-weight: 600;
}

.unit {
  font-size: 26rpx;
  margin-left: 12rpx;
}

.actions {
  margin-top: 36rpx;
}

.actions .btn + .btn {
  margin-top: 16rpx;
}

.shot {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #0f172a;
  border: 2rpx solid #334155;
}

.shot-hint {
  margin-top: 12rpx;
}

.pin-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(15, 23, 42, 0.64);
}

.pin-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #1e293b;
  border: 2rpx solid #334155;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.pin-dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #f8fafc;
  margin-bottom: 8rpx;
}

.pin-dialog .hint {
  margin-bottom: 24rpx;
}

.pin-dialog .field {
  margin-bottom: 28rpx;
}

.log-dot-setPin {
  background: #38bdf8;
}

.stack {
  margin-top: 28rpx;
}

.stack .btn + .btn {
  margin-top: 16rpx;
}

.log-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.log-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  background: #64748b;
  flex-shrink: 0;
}

.log-dot-approve,
.log-dot-pin {
  background: #4ade80;
}

.log-dot-wake,
.log-dot-bind {
  background: #fbbf24;
}

.log-dot-lock,
.log-dot-reject {
  background: #f87171;
}

.log-action {
  font-size: 30rpx;
  color: #f1f5f9;
}

.log-time {
  font-size: 24rpx;
  margin-top: 6rpx;
}
