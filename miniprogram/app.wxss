page {
  background: #0b1220;
  color: #f4f7fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  min-height: 100%;
}

.wrap {
  padding: 32rpx;
}

.card {
  background: #152033;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.muted {
  color: #8b9bb4;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.status {
  color: #f5a623;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.btn {
  background: #f5a623;
  color: #111;
  text-align: center;
  border-radius: 16rpx;
  padding: 22rpx 0;
  font-weight: 700;
  margin-top: 16rpx;
}

.btn-ghost {
  background: #2a3a55;
  color: #f4f7fb;
}

.row {
  display: flex;
  gap: 16rpx;
}

.row .btn {
  flex: 1;
}
