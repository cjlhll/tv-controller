<view class="wrap" wx:if="{{device}}">
  <view class="card">
    <view class="device-top">
      <view>
        <view class="device-name">{{device.name}}</view>
        <view class="device-meta">{{device.formText}} · {{device.shortId}}</view>
      </view>
      <view class="device-side">
        <view class="pill pill-{{statusKind}}">{{statusText}}</view>
        <view class="pill" bindtap="openPinDialog">{{device.pin || '未设置'}}</view>
      </view>
    </view>
    <view class="device-watch">今日已看 {{todayWatchText}}</view>
  </view>

  <view class="section-label">{{isUnlocked ? '设置使用时间' : '选择使用时长'}}</view>
  <view class="grid">
    <view
      wx:for="{{presets}}"
      wx:key="key"
      class="opt {{selectedKey === item.key ? 'opt-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectPreset"
    >{{item.label}}</view>
  </view>

  <view class="section-label">自定义</view>
  <view class="field {{selectedKey === 'custom' ? 'field-on' : ''}}">
    <input
      class="input"
      type="number"
      value="{{customMin}}"
      bindfocus="onCustomFocus"
      bindinput="onCustom"
    />
    <view class="unit">分钟</view>
  </view>

  <view class="actions">
    <view class="btn btn-primary" bindtap="approveSelected">{{approveLabel}}</view>
    <view class="btn btn-danger" bindtap="reject">{{isUnlocked ? '立即回锁' : '拒绝并保持锁定'}}</view>
  </view>

  <view class="section-label">远程操作</view>
  <view class="row">
    <view class="btn btn-secondary" bindtap="takeScreenshot">{{shotLoading ? '截图中…' : '获取截图'}}</view>
    <view class="btn btn-danger" bindtap="lockDevice">远程休眠</view>
  </view>
  <image
    wx:if="{{shotPath}}"
    class="shot"
    src="{{shotPath}}"
    mode="widthFix"
    show-menu-by-longpress
    binderror="onShotError"
  />
  <view wx:if="{{shotHint}}" class="hint shot-hint">{{shotHint}}</view>
</view>
<view class="wrap" wx:else>
  <view class="card empty">
    <view class="empty-title">找不到设备</view>
    <view class="empty-desc">它可能尚未绑定到当前账号。</view>
  </view>
</view>

<view wx:if="{{pinDialog}}" class="pin-mask" catchtap="closePinDialog" catchtouchmove="keepPinDialog">
  <view class="pin-dialog" catchtap="keepPinDialog">
    <view class="pin-dialog-title">修改 PIN</view>
    <view class="hint">当前 {{device.pin || '未设置'}}，输入 4–6 位数字</view>
    <view class="field">
      <input
        class="input"
        type="digit"
        maxlength="6"
        focus
        adjust-position="{{false}}"
        hold-keyboard
        confirm-type="done"
        placeholder="新 PIN"
        value="{{newPin}}"
        bindinput="onNewPin"
        bindconfirm="savePin"
      />
    </view>
    <view class="row">
      <view class="btn btn-secondary" bindtap="closePinDialog">取消</view>
      <view class="btn btn-primary" bindtap="savePin">保存</view>
    </view>
  </view>
</view>
