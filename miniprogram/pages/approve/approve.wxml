<view class="wrap" wx:if="{{device}}">
  <view class="card">
    <view class="device-top">
      <view>
        <view class="device-name">{{device.name}}</view>
        <view class="device-meta">{{device.formText}} · {{device.shortId}}</view>
      </view>
      <view class="pill pill-{{statusKind}}">{{statusText}}</view>
    </view>
    <view class="hw-specs" wx:if="{{device.hw}}">
      <view class="hw-spec">
        <text class="hw-spec-k">系统</text>
        <text class="hw-spec-v">{{device.hw.os}}</text>
      </view>
      <view class="hw-spec">
        <text class="hw-spec-k">屏幕</text>
        <text class="hw-spec-v">{{device.hw.screen}}</text>
      </view>
      <view class="hw-spec">
        <text class="hw-spec-k">运存</text>
        <text class="hw-spec-v">{{device.hw.ram}}</text>
      </view>
      <view class="hw-spec">
        <text class="hw-spec-k">存储</text>
        <text class="hw-spec-v">{{device.hw.storage}}</text>
      </view>
    </view>
  </view>

  <view class="section-label">{{isUnlocked ? '延长使用时间' : '选择使用时长'}}</view>
  <view class="grid">
    <view
      wx:for="{{presets}}"
      wx:key="key"
      class="opt {{selectedKey === item.key ? 'opt-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectPreset"
    >{{item.label}}</view>
  </view>

  <view class="section-label">自定义</view>
  <view class="field">
    <input class="input" type="number" value="{{customMin}}" bindinput="onCustom" />
    <view class="unit">分钟</view>
  </view>

  <view class="actions">
    <view class="btn btn-primary" bindtap="approveSelected">{{approveLabel}}</view>
    <view class="btn btn-danger" bindtap="reject">{{isUnlocked ? '立即回锁' : '拒绝并保持锁定'}}</view>
  </view>

  <view class="section-label">远程操作</view>
  <view class="row">
    <view class="btn btn-secondary" bindtap="takeScreenshot">{{shotLoading ? '截图中…' : '获取截图'}}</view>
    <view class="btn btn-danger" bindtap="lockDevice">远程锁屏</view>
  </view>
  <image
    wx:if="{{shotPath}}"
    class="shot"
    src="{{shotPath}}"
    mode="widthFix"
    show-menu-by-longpress
    binderror="onShotError"
  />
  <view wx:if="{{shotHint}}" class="hint shot-hint">{{shotHint}}</view>
</view>
<view class="wrap" wx:else>
  <view class="card empty">
    <view class="empty-title">找不到设备</view>
    <view class="empty-desc">它可能尚未绑定到当前账号。</view>
  </view>
</view>
