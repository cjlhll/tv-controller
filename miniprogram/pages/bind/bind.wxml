<view class="wrap">
  <view class="card empty">
    <view class="empty-title">绑定被控设备</view>
    <view class="empty-desc">扫描锁屏上的二维码，或在下方输入 6 位配对码。</view>
    <view class="stack">
      <view class="btn btn-primary" bindtap="scan">扫码绑定</view>
    </view>
  </view>

  <view class="section-label">手动输入配对码</view>
  <view class="field">
    <input
      class="input input-code"
      placeholder="A2B3C4"
      maxlength="6"
      value="{{token}}"
      bindinput="onToken"
    />
  </view>
  <view class="actions">
    <view class="btn btn-secondary" bindtap="bind">确认绑定</view>
  </view>
</view>
