<view class="wrap index-wrap">
  <view wx:if="{{empty}}" class="card empty">
    <view class="empty-title">还没有设备</view>
    <view class="empty-desc">打开被控设备上的 TV Lock，扫码或输入 6 位配对码。右下角可以绑定。</view>
  </view>

  <block wx:else>
    <view class="kicker">点卡片设置时长。右滑设置，左滑解绑。</view>
    <view class="swipe-row" wx:for="{{devices}}" wx:key="deviceId">
      <view class="swipe-actions swipe-actions-left">
        <view
          class="swipe-settings"
          data-id="{{item.deviceId}}"
          catchtap="onSettings"
        >设置</view>
      </view>
      <view class="swipe-actions">
        <view
          class="swipe-unbind"
          data-id="{{item.deviceId}}"
          data-name="{{item.name}}"
          catchtap="onUnbind"
        >解绑</view>
      </view>
      <view
        class="swipe-front {{item.swiping ? '' : 'swipe-anim'}}"
        style="transform: translateX({{item.offset}}px);"
        data-id="{{item.deviceId}}"
        data-index="{{index}}"
        bindtouchstart="onSwipeStart"
        catchtouchmove="onSwipeMove"
        bindtouchend="onSwipeEnd"
        bindtouchcancel="onSwipeEnd"
        bindtap="goApprove"
      >
        <view class="dev-card dev-card-{{item.statusKind}}">
          <view class="dev-top">
            <view class="dev-mark">{{item.formText}}</view>
            <view class="dev-info">
              <view class="dev-name">{{item.name}}</view>
              <view class="dev-meta">{{item.shortId}} · {{item.onlineText}}</view>
            </view>
            <view class="dev-side">
              <view class="dev-pill pill-{{item.statusKind}}">{{item.statusText}}</view>
              <view class="dev-pill dev-log" data-id="{{item.deviceId}}" catchtap="goLogs">记录</view>
            </view>
          </view>
          <view class="dev-watch">今日解锁时间 {{item.todayUnlockText}}，观看时间 {{item.todayWatchText}}</view>
        </view>
      </view>
    </view>
  </block>
</view>

<view class="fab">
  <view class="fab-main" bindtap="goBind">+</view>
</view>
