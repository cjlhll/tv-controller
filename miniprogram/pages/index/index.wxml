<view class="wrap">
  <view class="title">TV Lock</view>
  <view class="muted">打开设备后会推送服务通知。点批准可限时解锁。</view>

  <view wx:if="{{empty}}" class="card">
    <view>还没有绑定设备</view>
    <view class="muted">在被控设备上打开 TV Lock，扫码或输入 6 位配对码。</view>
  </view>

  <view wx:for="{{devices}}" wx:key="deviceId" class="card">
    <view class="title">{{item.name}}</view>
    <view class="muted">{{item.deviceId}} · {{item.form}}</view>
    <view class="status">{{item.statusText}}</view>
    <view class="row">
      <view class="btn" data-id="{{item.deviceId}}" bindtap="goApprove">批准 / 回锁</view>
      <view class="btn btn-ghost" data-id="{{item.deviceId}}" bindtap="goLogs">记录</view>
    </view>
  </view>

  <view class="btn" bindtap="goBind">扫码绑定</view>
  <view class="btn btn-ghost" bindtap="subscribe">接收下次打开提醒</view>
</view>
