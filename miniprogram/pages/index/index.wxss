.index-wrap {
  padding: 28rpx 0 calc(180rpx + env(safe-area-inset-bottom));
}

.index-wrap .kicker {
  padding: 0 32rpx;
}

.index-wrap .empty {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.swipe-row {
  position: relative;
  margin-bottom: 28rpx;
  overflow: hidden;
}

.swipe-actions {
  position: absolute;
  right: 32rpx;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
}

.swipe-unbind {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #b91c1c;
  color: #fff7ed;
  font-size: 28rpx;
  font-weight: 600;
}

.swipe-unbind:active {
  background: #991b1b;
}

.swipe-actions-left {
  right: auto;
  left: 32rpx;
}

.swipe-settings {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #1d4ed8;
  color: #eff6ff;
  font-size: 28rpx;
  font-weight: 600;
}

.swipe-settings:active {
  background: #1e40af;
}

.swipe-front {
  position: relative;
  z-index: 1;
  margin: 0 32rpx;
}

.swipe-anim {
  transition: transform 0.2s ease;
}

.dev-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  background: #1e293b;
  border: 2rpx solid #334155;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.dev-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.dev-card:active {
  background: #243044;
}

.dev-card-unlocked {
  border-color: #166534;
  background: #172554;
}

.dev-card-unlocked:active {
  background: #1e3a5f;
}

.dev-card-pending {
  border-color: #a16207;
}

.dev-mark {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: #0f172a;
  border: 2rpx solid #334155;
  color: #cbd5e1;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
  flex-shrink: 0;
}

.dev-info {
  flex: 1;
  min-width: 0;
}

.dev-name {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.25;
  color: #f8fafc;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-meta {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.dev-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  flex-shrink: 0;
}

.dev-watch {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #334155;
  color: #94a3b8;
  font-size: 24rpx;
}

.dev-card-unlocked .dev-watch {
  border-top-color: #1e3a8a;
}

.dev-pill {
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}

.dev-log {
  background: #334155;
  color: #cbd5e1;
}

.dev-log:active {
  opacity: 0.8;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 31;
}

.fab-main {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #d97706;
  color: #fff7ed;
  font-size: 64rpx;
  line-height: 104rpx;
  text-align: center;
  font-weight: 300;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.45);
}

.fab-main:active {
  opacity: 0.88;
}
