<view class="wrap">
  <view wx:if="{{!logs.length}}" class="card empty">
    <view class="empty-title">暂无记录</view>
    <view class="empty-desc">批准、回锁和唤醒会出现在这里。</view>
  </view>
  <view wx:for="{{logs}}" wx:key="createdAt" class="card">
    <view class="log-item">
      <view class="log-dot log-dot-{{item.action}}"></view>
      <view>
        <view class="log-action">{{item.actionText}}<text wx:if="{{item.extra}}"> · {{item.extra}}</text></view>
        <view class="log-time">{{item.timeText}}</view>
      </view>
    </view>
  </view>
</view>
