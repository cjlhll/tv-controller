<view class="wrap settings-wrap" wx:if="{{device}}">
  <view class="card">
    <view class="device-name">{{device.name}}</view>
    <view class="device-meta">{{device.formText}} · {{device.shortId}}</view>
  </view>

  <view class="section-label">卸载保护</view>
  <view class="card settings-switch-card">
    <view class="settings-switch-row">
      <view class="settings-switch-text">
        <view class="settings-switch-title">允许卸载本应用</view>
        <view class="hint">{{uninstallHint}}</view>
      </view>
        <switch
        checked="{{allowUninstall}}"
        disabled="{{uninstallBusy}}"
        color="#d97706"
        bindchange="onAllowUninstall"
      />
    </view>
    <view class="hint lock-cmd-note">加锁前请先关闭上方「允许卸载」。索尼 Emotion UI 的「添加快捷应用」仍可能列出本应用（系统不允许隐藏 Device Owner）；已.pin 的快捷需手动删。菜单里若出现卸载，禁止生效时应卸不掉。</view>
    <view class="lock-cmd" hover-class="lock-cmd-on" bindtap="copyLockOwnerCmd" data-kind="shell">
      <view class="lock-cmd-label">atvtools / 电视 shell · 点按复制</view>
      <view class="lock-cmd-text">{{lockOwnerCmdShell}}</view>
    </view>
    <view class="lock-cmd lock-cmd-second" hover-class="lock-cmd-on" bindtap="copyLockOwnerCmd" data-kind="adb">
      <view class="lock-cmd-label">电脑 adb · 点按复制</view>
      <view class="lock-cmd-text">{{lockOwnerCmdAdb}}</view>
    </view>
  </view>

  <view class="section-label">PIN 解锁默认时长</view>
  <view class="hint settings-hint">本机输入 PIN 后按此时长解锁，可随时改。</view>
  <view class="grid">
    <view
      wx:for="{{presets}}"
      wx:key="key"
      class="opt {{selectedKey === item.key ? 'opt-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="selectPreset"
    >{{item.label}}</view>
  </view>

  <view class="section-label">自定义</view>
  <view class="field {{selectedKey === 'custom' ? 'field-on' : ''}}">
    <input
      class="input"
      type="number"
      value="{{customMin}}"
      bindfocus="onCustomFocus"
      bindinput="onCustom"
    />
    <view class="unit">分钟</view>
  </view>

  <view class="actions">
    <view class="btn btn-primary" bindtap="save">{{saveLabel}}</view>
  </view>
</view>
<view class="wrap" wx:else>
  <view class="card empty">
    <view class="empty-title">找不到设备</view>
    <view class="empty-desc">它可能尚未绑定到当前账号。</view>
  </view>
</view>
