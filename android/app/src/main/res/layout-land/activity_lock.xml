<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/lock_pad">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/lock_gutter"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/muted"
            android:textSize="@dimen/brand_size"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:paddingEnd="8dp"
                    android:text="@string/lock_title"
                    android:textColor="@color/text"
                    android:textSize="@dimen/title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="已锁定"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lock_pending"
                android:textColor="@color/muted"
                android:textSize="@dimen/body_size" />

            <TextView
                android:id="@+id/deviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="@dimen/qr_size"
                android:layout_height="@dimen/qr_size"
                android:background="@drawable/bg_card"
                android:contentDescription="pair qr"
                android:padding="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/pairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:letterSpacing="0.16"
                android:textColor="@color/accent"
                android:textSize="@dimen/pair_code_size"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="@dimen/action_col_width"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/requestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_primary"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:focusedByDefault="true"
            android:minHeight="@dimen/btn_min_height"
            android:nextFocusDown="@id/pinButton"
            android:text="@string/request_unlock"
            android:textAllCaps="false"
            android:textColor="@color/accent_on"
            android:textSize="@dimen/body_size"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/pinButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_ghost"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:minHeight="@dimen/btn_min_height"
            android:nextFocusUp="@id/requestButton"
            android:nextFocusDown="@id/refreshButton"
            android:text="@string/pin_unlock"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="@dimen/body_size"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_ghost"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:minHeight="@dimen/btn_min_height"
            android:nextFocusUp="@id/pinButton"
            android:nextFocusDown="@id/lockNowButton"
            android:text="@string/refresh_pair"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="@dimen/body_size"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/lockNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_danger"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:minHeight="@dimen/btn_min_height"
            android:nextFocusUp="@id/refreshButton"
            android:text="@string/lock_now"
            android:textAllCaps="false"
            android:textColor="@color/danger"
            android:textSize="@dimen/body_size"
            android:visibility="gone"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
